CONFIG_IDF_TARGET="esp32c3"
# UART0 primary + USB-Serial-JTAG secondary: same log on the bench UART and COM4.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# QIO was expected to halve ICache line fill time (DIO spends four transfers per
# 32-bit word, QIO two).  Tried on 2026-11-26: a full QIO image (bootloader +
# app, merge_bin --flash_mode qio) does not boot on this handset - the ROM loads
# the bootloader ("mode:QIO") and then resets in a TG0WDT loop, i.e. the flash
# part (JEDEC 0x204017, 8 MB) answers DIO correctly but not QIO as the boot ROM
# drives it.  That is consistent with the QE bit never being set (esptool does
# not touch it).  Until someone proves a QE-enable step works, DIO stays.
# CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# The preview task uses the main task; leave room for zlib state and logs.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- digicore-c3 ----------------------------------------------------------
# Custom partition table: nvs / phy / factory (2 MiB) / roms (6 MiB sparse ROM).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The interpreter loop runs ~0.2 s at a time inside one task; the task WDT is
# already off above.  Compile-time ceiling INFO: the runtime level is INFO, so
# DEBUG strings could never be printed and only cost image space (R7 audit).
# Raise this together with CONFIG_LOG_DEFAULT_LEVEL to see page-cache stats.
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_COMPILER_LTO=y

CONFIG_ESP_CONSOLE_UART_TX_BUF=2048
